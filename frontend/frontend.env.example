# ============================================================
# e-SpazaSethu — Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to GitHub — it is listed in .gitignore.
#
# IMPORTANT: All Vite environment variables MUST start with
# VITE_ or they will not be accessible in the browser.
# ============================================================


# ------------------------------------------------------------
# API
# ------------------------------------------------------------

# The base URL of the Spring Boot backend API.
# During local dev this points to your locally running backend.
# Change this to your deployed backend URL in production.
VITE_API_BASE_URL=http://localhost:8080/api/v1
